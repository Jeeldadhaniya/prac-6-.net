
@model List<Practical_6.Models.Product>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Product Catalog</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: linear-gradient(135deg, #f5f7fa, #e4ecf7);
            min-height: 100vh;
            font-family: Arial, sans-serif;
            padding: 30px 15px;
        }

        .page-header {
            background: linear-gradient(135deg, #0d6efd, #6610f2);
            color: white;
            text-align: center;
            padding: 25px;
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
        }

        .catalog-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        }

        .table {
            vertical-align: middle;
        }

            .table thead th {
                background-color: #0d6efd;
                color: white;
                padding: 15px;
            }

            .table tbody td {
                padding: 15px;
            }

        .product-image {
            width: 90px;
            height: 80px;
            object-fit: contain;
            background: white;
            border-radius: 8px;
        }

        .price {
            color: #198754;
            font-weight: bold;
            white-space: nowrap;
        }

        .details-btn {
            border-radius: 20px;
            padding: 7px 15px;
        }

        .product-count {
            color: #6610f2;
            font-weight: bold;
        }

        footer {
            text-align: center;
            margin-top: 25px;
            color: #6c757d;
        }

        @@media (max-width: 576px) {
            body {
                padding: 15px 5px;
            }

            .catalog-card {
                padding: 12px;
            }

            .product-image {
                width: 60px;
                height: 60px;
            }

            .table thead th,
            .table tbody td {
                padding: 8px;
                font-size: 12px;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="page-header">
            <h1>🛍️ Product Catalog</h1>
            <p class="mb-0">Explore our latest products</p>
        </div>

        <div class="catalog-card">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <h3 class="mb-0">Available Products</h3>
                <span class="product-count">@Model.Count Products</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-bordered text-center">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Product Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Details</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var i in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@i.ImageUrl"
                                         alt="@i.ProductName"
                                         class="product-image" />
                                </td>

                                <td class="fw-bold">@i.ProductName</td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @i.ProductCategory
                                    </span>
                                </td>

                                <td class="price">
                                    ₹@i.ProductPrice.ToString("N0")
                                </td>

                                <td>
                                    @Html.ActionLink(
                                        "View Details",
                                        "Details",
                                        "Products",
                                        new { id = i.ProductId },
                                        new { @class = "btn btn-primary btn-sm details-btn" }
                                    )
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <footer>
            © 2026 Product Catalog | MVC Application
        </footer>
    </div>
</body>
</html>
