
@model Practical_6.Models.Product

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Product Details - @Model.ProductName</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: linear-gradient(135deg, #f5f7fa, #e4ecf7);
            min-height: 100vh;
            font-family: Arial, sans-serif;
            padding: 30px 15px;
        }

        .page-header {
            background: linear-gradient(135deg, #0d6efd, #6610f2);
            color: white;
            text-align: center;
            padding: 25px;
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
        }

        .details-card {
            max-width: 850px;
            margin: 0 auto;
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        }

        .product-image {
            display: block;
            width: 100%;
            max-width: 350px;
            height: 300px;
            object-fit: contain;
            margin: 0 auto 25px;
            background: white;
            border-radius: 10px;
        }

        .product-name {
            color: #0d6efd;
            font-weight: bold;
        }

        .price {
            color: #198754;
            font-size: 28px;
            font-weight: bold;
        }

        .detail-row {
            padding: 12px 0;
            border-bottom: 1px solid #dee2e6;
        }

        .back-btn {
            border-radius: 25px;
            padding: 10px 22px;
        }

        footer {
            text-align: center;
            margin-top: 25px;
            color: #6c757d;
        }

        @@media (max-width: 576px) {
            body {
                padding: 15px 5px;
            }

            .details-card {
                padding: 18px;
            }

            .product-image {
                height: 220px;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="page-header">
            <h1>🛍️ Product Details</h1>
            <p class="mb-0">View complete product information</p>
        </div>

        <div class="details-card">
            <img src="@Model.ImageUrl"
                 alt="@Model.ProductName"
                 class="product-image" />

            <h2 class="product-name text-center mb-4">
                @Model.ProductName
            </h2>

            <div class="detail-row">
                <strong>Product ID:</strong>
                <span class="float-end">@Model.ProductId</span>
            </div>

            <div class="detail-row">
                <strong>Product Name:</strong>
                <span class="float-end">@Model.ProductName</span>
            </div>

            <div class="detail-row">
                <strong>Category:</strong>
                <span class="float-end">@Model.ProductCategory</span>
            </div>

            <div class="detail-row">
                <strong>Price:</strong>
                <span class="float-end price">
                    ₹@Model.ProductPrice.ToString("N0")
                </span>
            </div>

            <div class="text-center mt-4">
                @Html.ActionLink(
                    "← Back to Product Catalog",
                    "Index",
                    "Products",
                    null,
                    new { @class = "btn btn-primary back-btn" }
                )
            </div>
        </div>

        <footer>
            © 2026 Product Catalog | MVC Application
        </footer>
    </div>
</body>
</html>
